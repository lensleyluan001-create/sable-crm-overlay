{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/want",
      "destination": "https://sable-floor-web.vercel.app/",
      "permanent": false
    },
    {
      "source": "/want/",
      "destination": "https://sable-floor-web.vercel.app/",
      "permanent": false
    },
    {
      "source": "/want.html",
      "destination": "https://sable-floor-web.vercel.app/",
      "permanent": false
    },
    {
      "source": "/enquire",
      "destination": "https://sable-floor-web.vercel.app/",
      "permanent": false
    },
    {
      "source": "/enquire/",
      "destination": "https://sable-floor-web.vercel.app/",
      "permanent": false
    },
    {
      "source": "/enquire.html",
      "destination": "https://sable-floor-web.vercel.app/",
      "permanent": false
    },
    {
      "source": "/lookbook",
      "destination": "https://sable-floor-web.vercel.app/",
      "permanent": false
    },
    {
      "source": "/lookbook/",
      "destination": "https://sable-floor-web.vercel.app/",
      "permanent": false
    },
    {
      "source": "/book",
      "destination": "https://sable-floor-web.vercel.app/",
      "permanent": false
    },
    {
      "source": "/client",
      "destination": "https://sable-floor-web.vercel.app/",
      "permanent": false
    },
    {
      "source": "/ask",
      "destination": "https://sable-floor-web.vercel.app/",
      "permanent": false
    },
    {
      "source": "/order",
      "destination": "https://sable-floor-web.vercel.app/",
      "permanent": false
    },
    {
      "source": "/how",
      "destination": "https://sable-floor-web.vercel.app/how",
      "permanent": false
    },
    {
      "source": "/how/",
      "destination": "https://sable-floor-web.vercel.app/how",
      "permanent": false
    },
    {
      "source": "/how.html",
      "destination": "https://sable-floor-web.vercel.app/how",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/login/",
      "destination": "/index.html"
    },
    {
      "source": "/desk",
      "destination": "/index.html?desk=1"
    },
    {
      "source": "/desk/",
      "destination": "/index.html?desk=1"
    },
    {
      "source": "/track",
      "destination": "/track.html"
    },
    {
      "source": "/track/",
      "destination": "/track.html"
    },
    {
      "source": "/track/:ref",
      "destination": "/track.html?t=:ref"
    }
  ]
}
